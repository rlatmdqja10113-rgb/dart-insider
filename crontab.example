# 직접 서버(라즈베리파이, 저가 VPS 등)에서 돌릴 때. `crontab -e` 로 붙여넣는다.
# 서버 시간대가 KST 인지 확인할 것. UTC 면 시각을 9시간 빼서 적는다.

# 평일 아침 07:10 — 전날 접수분 리포트
10 7 * * 1-5  cd /opt/dart-insider && /usr/bin/python3 -m insider run --days 7 --lookback 1 >> data/cron.log 2>&1

# 매일 21:00 — 저녁에 몰리는 공시를 미리 받아두기 (발송 없음, 아침 실행이 빨라진다)
0 21 * * *    cd /opt/dart-insider && /usr/bin/python3 -m insider run --days 3 --dry-run >> data/cron.log 2>&1
